{
  "name": "live-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -R migrations dist/migrations && cp index.html catalogo.html lives.html dist/",
    "start": "npm run build && node dist/server.js",
    "dev": "node --import tsx server.ts",
    "db:migrate": "npm run build && node dist/src/migrate.mjs",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.mjs test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
